generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CAPTAIN
  PLAYER
}

enum WalletTransactionType {
  TOP_UP
  MATCH_PAYMENT
  CONTRIBUTION_PAYMENT
  REFUND
  MANUAL_CREDIT
  MANUAL_DEBIT
  BONUS
  ADJUSTMENT
}

enum TopUpStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_PAYMENT
  OTHER
}

enum MatchStatus {
  DRAFT
  OPEN
  FULL
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum MatchParticipantStatus {
  INVITED
  CONFIRMED
  WAITLISTED
  CANCELLED
  ABSENT
  ATTENDED
}

enum MatchPaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum ContributionStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ContributionParticipantStatus {
  PENDING
  PAID
  EXEMPTED
  FAILED
  REFUNDED
}

enum ExpenseCategory {
  FIELD
  BALL
  BIBS
  WATER
  REFEREE
  EQUIPMENT
  OTHER
}

enum NotificationType {
  POLL_OPENED
  POLL_CLOSING_SOON
  POLL_NEAR_FULL
  POLL_PROMOTED
  MATCH_CREATED
  MATCH_UPDATED
  LOW_BALANCE
  MATCH_CONFIRMATION
  MATCH_CANCELLED
  TOP_UP_APPROVED
  TOP_UP_REJECTED
  CONTRIBUTION_CREATED
  CONTRIBUTION_DEBITED
  REFUND_CREATED
  GENERAL
}

enum SecurityAuditType {
  PASSWORD_RESET
}

enum PollStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
  CANCELLED
}

enum PollResponseChoice {
  PRESENT
  ABSENT
  MAYBE
}

enum PresenceSource {
  QR
  MANUAL
}

model User {
  id                       String                    @id @default(cuid())
  name                     String
  email                    String                    @unique
  passwordHash             String
  passwordChangedAt        DateTime?
  sessionVersion           Int                       @default(0)
  mustChangePassword       Boolean                   @default(false)
  role                     Role                      @default(PLAYER)
  phone                    String?
  isActive                 Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  wallet                   Wallet?
  topUps                   WalletTopUp[]
  generatedReceipts        WalletTopUp[]             @relation("TopUpReceiptGeneratedBy")
  createdMatches           Match[]                   @relation("MatchCreatedBy")
  createdContributions     Contribution[]            @relation("ContributionCreatedBy")
  createdExpenses          Expense[]                 @relation("ExpenseCreatedBy")
  createdTransactions      WalletTransaction[]       @relation("TransactionCreatedBy")
  reviewedTopUps           WalletTopUp[]             @relation("TopUpReviewedBy")
  notifications            Notification[]
  participatedMatches      MatchParticipant[]
  contributionParticipants ContributionParticipant[]
  createdPolls             Poll[]                    @relation("PollCreatedBy")
  pollResponses            PollResponse[]
  pollManagedResponses     PollResponse[]            @relation("PollManagedBy")
  presenceLogs             MatchPresenceLog[]        @relation("MatchPresenceUser")
  presenceActions          MatchPresenceLog[]        @relation("MatchPresenceActor")
  securityAuditActions     SecurityAudit[]            @relation("SecurityAuditActor")
  securityAuditTargets     SecurityAudit[]            @relation("SecurityAuditTarget")
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  balance      Decimal             @default(0) @db.Decimal(12, 2)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id                      String                   @id @default(cuid())
  walletId                String
  type                    WalletTransactionType
  amount                  Decimal                  @db.Decimal(12, 2)
  balanceBefore           Decimal                  @db.Decimal(12, 2)
  balanceAfter            Decimal                  @db.Decimal(12, 2)
  description             String
  referenceType           String?
  referenceId             String?
  createdById             String?
  createdAt               DateTime                 @default(now())
  wallet                  Wallet                   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdBy               User?                    @relation("TransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  contributionParticipant ContributionParticipant? @relation("ContributionParticipantTransaction")

  @@index([walletId, createdAt])
  @@index([createdById, createdAt])
  @@index([referenceType, referenceId])
}

model WalletTopUp {
  id                    String      @id @default(cuid())
  userId                String
  amount                Decimal     @db.Decimal(12, 2)
  paymentMethod         PaymentMethod
  note                  String?
  proofUrl              String?
  status                TopUpStatus @default(PENDING)
  reviewedById          String?
  reviewedAt            DateTime?
  receiptNumber         String?     @unique
  receiptIssuedAt       DateTime?
  receiptGeneratedById  String?
  receiptShareTokenHash String?
  receiptShareTokenExpiresAt DateTime?
  receiptShareTokenRevokedAt DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy            User?       @relation("TopUpReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  receiptGeneratedBy    User?       @relation("TopUpReceiptGeneratedBy", fields: [receiptGeneratedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, createdAt])
}

model SecurityAudit {
  id            String             @id @default(cuid())
  type          SecurityAuditType
  actorId       String?
  targetUserId  String?
  metadata      Json?
  createdAt     DateTime           @default(now())
  actor         User?              @relation("SecurityAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser    User?              @relation("SecurityAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
}

model Match {
  id                   String             @id @default(cuid())
  title                String
  matchDate            DateTime
  startTime            String
  endTime              String
  location             String
  bookingReference     String?
  capacity             Int
  participationFee     Decimal            @default(10) @db.Decimal(12, 2)
  status               MatchStatus        @default(DRAFT)
  cancellationDeadline DateTime?
  notes                String?
  qrTokenId            String?            @unique
  qrTokenHash          String?
  qrTokenExpiresAt     DateTime?
  qrDisabledAt         DateTime?
  qrGeneratedAt        DateTime?
  createdById          String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  createdBy            User               @relation("MatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  poll                 Poll?              @relation("PollToMatch")
  participants         MatchParticipant[]
  expenses             Expense[]
  presenceLogs         MatchPresenceLog[]

  @@index([matchDate, status])
  @@index([createdById, createdAt])
}

model MatchParticipant {
  id            String                 @id @default(cuid())
  matchId       String
  userId        String
  status        MatchParticipantStatus @default(INVITED)
  paymentStatus MatchPaymentStatus     @default(PENDING)
  amountCharged Decimal                @default(0) @db.Decimal(12, 2)
  joinedAt      DateTime               @default(now())
  cancelledAt   DateTime?
  refundedAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  match         Match                  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  presenceLogs MatchPresenceLog[]

  @@unique([matchId, userId])
  @@index([matchId])
  @@index([userId, status])
}

model MatchPresenceLog {
  id             String         @id @default(cuid())
  matchId        String
  userId         String
  participantId  String?
  actorId        String?
  source         PresenceSource
  createdAt      DateTime       @default(now())
  match          Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user           User           @relation("MatchPresenceUser", fields: [userId], references: [id], onDelete: Cascade)
  participant    MatchParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  actor          User?          @relation("MatchPresenceActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([matchId, createdAt])
  @@index([userId, createdAt])
  @@index([participantId])
}

model Contribution {
  id              String                    @id @default(cuid())
  title           String
  description     String
  amountPerPlayer Decimal                   @db.Decimal(12, 2)
  targetAmount    Decimal?                  @db.Decimal(12, 2)
  status          ContributionStatus        @default(DRAFT)
  dueDate         DateTime?
  automaticDebit  Boolean                   @default(true)
  createdById     String
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  createdBy       User                      @relation("ContributionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  participants    ContributionParticipant[]
  expenses        Expense[]

  @@index([createdById, createdAt])
  @@index([status, createdAt])
}

model ContributionParticipant {
  id                  String                        @id @default(cuid())
  contributionId      String
  userId              String
  amount              Decimal                       @db.Decimal(12, 2)
  status              ContributionParticipantStatus @default(PENDING)
  paidAt              DateTime?
  walletTransactionId String?                       @unique
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  contribution        Contribution                  @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  user                User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletTransaction   WalletTransaction?            @relation("ContributionParticipantTransaction", fields: [walletTransactionId], references: [id], onDelete: SetNull)

  @@unique([contributionId, userId])
  @@index([contributionId])
  @@index([contributionId, userId])
  @@index([status, createdAt])
}

model Expense {
  id             String          @id @default(cuid())
  title          String
  description    String
  category       ExpenseCategory
  amount         Decimal         @db.Decimal(12, 2)
  expenseDate    DateTime
  matchId        String?
  contributionId String?
  createdById    String
  receiptUrl     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  match          Match?          @relation(fields: [matchId], references: [id], onDelete: SetNull)
  contribution   Contribution?   @relation(fields: [contributionId], references: [id], onDelete: SetNull)
  createdBy      User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([matchId])
  @@index([contributionId])
  @@index([createdById, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  readAt    DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model AppSettings {
  id                   String   @id @default(cuid())
  singletonKey         String   @unique
  organizationName     String
  logoUrl              String?
  defaultGround        String
  defaultMatchPrice    Decimal  @db.Decimal(12, 2)
  defaultCapacity      Int
  walletAlertThreshold Decimal  @db.Decimal(12, 2)
  whatsappTemplate     String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Poll {
  id                   String          @id @default(cuid())
  title                String
  description          String?
  matchTitle           String
  matchDate            DateTime
  startTime            String
  endTime              String
  location             String
  capacity             Int
  matchAmount          Decimal         @default(10) @db.Decimal(12, 2)
  allowResponseChanges Boolean         @default(true)
  manualControl        Boolean         @default(false)
  opensAt              DateTime?
  closesAt             DateTime?
  status               PollStatus      @default(DRAFT)
  matchId              String?         @unique
  createdById          String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  createdBy            User            @relation("PollCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  match                Match?          @relation("PollToMatch", fields: [matchId], references: [id], onDelete: SetNull)
  responses            PollResponse[]

  @@index([status, createdAt])
  @@index([matchDate, status])
}

model PollResponse {
  id             String             @id @default(cuid())
  pollId         String
  userId         String
  response       PollResponseChoice
  isWaitlisted   Boolean            @default(false)
  waitlistOrder  Int?
  respondedAt    DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  managedById    String?
  managedAt      DateTime?
  poll           Poll               @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  managedBy      User?              @relation("PollManagedBy", fields: [managedById], references: [id], onDelete: SetNull)

  @@unique([pollId, userId])
  @@index([pollId, response])
  @@index([pollId, isWaitlisted])
  @@index([userId, createdAt])
}
